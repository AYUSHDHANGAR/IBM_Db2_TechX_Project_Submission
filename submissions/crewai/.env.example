# IBM Db2 Connection Parameters (Shared across Haystack and CrewAI)
DB2_DATABASE=BLUDB
DB2_HOSTNAME=localhost
DB2_PORT=50000
DB2_USERNAME=db2admin
DB2_PASSWORD=your_db2_password_here
DB2_TABLE_NAME=JOB_POSTINGS
DB2_PROTOCOL=TCPIP

# Local Offline Embedding Model Configuration (IBM Granite Multilingual)
# Native dimension: 768 (Matryoshka truncation: 512, 384, 256, 128)
EMBEDDING_MODEL=ibm-granite/granite-embedding-311m-multilingual-r2
EMBEDDING_DIMENSION=768

# LLM Reasoning Key for CrewAI (if using OpenAI / watsonx / Ollama)
# If OPENAI_API_KEY is not set or placeholder, local Ollama (granite3.3:8b) is automatically used.
OPENAI_API_KEY=your_llm_api_key_here
OLLAMA_MODEL=ollama/granite3.3:8b
OLLAMA_BASE_URL=http://localhost:11434
