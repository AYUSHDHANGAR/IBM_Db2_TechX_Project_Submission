# ==============================================================================
# BAKEBOX CHOCO AI — Environment Configuration Template
# IBM Db2 TechX Summit Hackathon Submission
# ==============================================================================

# IBM Db2 Connection Parameters (Local Community Edition or IBMDB201)
# Schema owner runs src/ingest.py once; runtime app should use least-privilege roles (sql/db2_least_privilege.sql)
DB2_HOST=127.0.0.1
DB2_PORT=50000
DB2_DATABASE=IBMDB201
DB2_USER=your_db2_app_username_here
DB2_PASSWORD=your_db2_app_password_here

# Optional: Dedicated Read-Only Least-Privilege Db2 User (BAKEBOX_READER_ROLE)
# Used automatically for RAG vector queries & order tracking; falls back to DB2_USER if unset.
DB2_READONLY_USER=
DB2_READONLY_PASSWORD=

# Embedding Model Configuration (Local FastEmbed / SentenceTransformers)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Optional: Google Gemini LLM API Key & Model Configuration
# Leave blank or omit to run in deterministic offline ground-truth mode (--no-llm)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
